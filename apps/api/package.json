    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/passport-jwt": "^4.0.1",
    "decimal.js": "^10.6.0",
    "jest": "^29.7.0",
