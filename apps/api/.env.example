# Copy this file to .env and fill in real values. Never commit .env itself.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/mswd_erp?schema=public"

# JWT signing secret — must be at least 32 characters. Generate a real
# random value for any non-local environment (e.g. `openssl rand -hex 32`).
JWT_SECRET="dev-only-placeholder-secret-change-me-32chars-min"
JWT_EXPIRES_IN="8h"
