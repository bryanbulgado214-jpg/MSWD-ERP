// MSWD ERP — Prisma schema.
//
// CORE PLATFORM ONLY. No Budgeting, Accounting, Procurement, Inventory,
// or HR models exist yet — those are added in later, separate migrations
// as each module is implemented, per docs/04_Database's approved
// architecture and its documented implementation order.
//
// Naming: Prisma model/field names are idiomatic PascalCase/camelCase for
// ergonomic TypeScript use; every model/field is explicitly mapped via
// @@map/@map to a snake_case table/column name, so the actual database
// schema is 100% snake_case as required — this is standard Prisma
// practice, not a deviation from the naming standard.
//
// Reconciliation notes vs. docs/04_Database/MSWD_ERP_Database_Architecture_v2.md:
// - Workflow tables use the names given in this implementation task
//   (workflow_definitions / workflow_steps / workflow_instances /
//   workflow_actions) rather than v2's (workflow_templates /
//   workflow_template_steps / workflow_instances / workflow_approvals).
//   This supersedes v2's naming for these four tables.
// - organizational_units, locations, document_sequences, comments,
//   notifications, and system_settings are new tables not present in v2,
//   added per this task's explicit 24-table list.
// - currencies, banks, bank_accounts, chart_of_accounts, and
//   unit_of_measures from v2's "core" schema are DEFERRED — not part of
//   this Core Platform pass, per the explicit instruction to implement
//   only the 24 listed tables. organization_settings therefore stores a
//   plain default_currency_code for now rather than a currency_id FK;
//   that becomes a proper FK once the currencies table exists in a later
//   migration (additive, non-breaking change).
// See docs/04_Database/ for the full rationale.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════════════

enum OrganizationalUnitType {
  organization_wide
  division
  department
  section
  office
  unit

  @@map("organizational_unit_type")
}

enum FiscalYearStatus {
  open
  closed

  @@map("fiscal_year_status")
}

enum AccountingPeriodStatus {
  open
  closed

  @@map("accounting_period_status")
}

enum AuditAction {
  insert
  update
  delete
  status_change

  @@map("audit_action")
}

enum WorkflowInstanceStatus {
  in_progress
  approved
  rejected
  cancelled

  @@map("workflow_instance_status")
}

enum WorkflowActionDecision {
  approved
  rejected
  returned
  cancelled

  @@map("workflow_action_decision")
}

// ════════════════════════════════════════════════════════════════════
// ORGANIZATION STRUCTURE
// ════════════════════════════════════════════════════════════════════

/// One row per organization. V1 seeds exactly one row — this table exists
/// so a future multi-organization deployment is a data-population
/// exercise, not a schema migration. No organization-specific values are
/// hard-coded into the schema itself; they only ever live in seed data.
model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings             OrganizationSettings?
  departments          Department[]
  organizationalUnits  OrganizationalUnit[]
  responsibilityCenters ResponsibilityCenter[]
  locations            Location[]
  users                User[]
  roles                Role[]
  fiscalYears          FiscalYear[]
  fundSources          FundSource[]
  documentSequences    DocumentSequence[]
  attachments          Attachment[]
  comments             Comment[]
  auditLogs            AuditLog[]
  workflowDefinitions  WorkflowDefinition[]
  workflowInstances    WorkflowInstance[]
  notifications        Notification[]
  budgetCycles         BudgetCycle[]
  budgetHeaders        BudgetHeader[]
  budgetReleases       BudgetRelease[]
  budgetReservations   BudgetReservation[]
  budgetTransactionLogs BudgetTransactionLog[]
  purchaseRequests     PurchaseRequest[]
  procurementCategories ProcurementCategory[]
  ppmpItems            PpmpItem[]
  appItems             AppItem[]
  delegationAuthorities DelegationAuthority[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  cafs                  CertificationOfAvailability[]
  obligationRequests    ObligationRequest[]
  inspectionReports     InspectionReport[]
  disbursementVouchers  DisbursementVoucher[]
  inventoryItems        InventoryItem[]
  stockReceipts         StockReceipt[]
  stockCards            StockCard[]
  requisitionIssueSlips RequisitionIssueSlip[]
  propertyRecords       PropertyRecord[]
  accountabilityRecords AccountabilityRecord[]
  physicalCounts        PhysicalCount[]
  disposalRequests      DisposalRequest[]
  chartOfAccounts       ChartOfAccount[]
  banks                 Bank[]
  bankAccounts          BankAccount[]
  accountMappings       AccountMapping[]
  journalEntryVouchers  JournalEntryVoucher[]
  checks                Check[]
  bankReconciliations   BankReconciliation[]
  consumers             Consumer[]
  meters                Meter[]
  rateSchedules         RateSchedule[]
  billingPeriods        BillingPeriod[]
  meterReadings         MeterReading[]
  bills                 Bill[]
  payments              Payment[]
  disconnectionOrders   DisconnectionOrder[]
  positions             Position[]
  salaryGrades          SalaryGrade[]
  employees             Employee[]
  leaveTypes            LeaveType[]
  leaveBalances         LeaveBalance[]
  leaveApplications     LeaveApplication[]
  dtrUploads            DtrUpload[]
  dtrRecords            DtrRecord[]
  allowanceTypes        AllowanceType[]
  employeeAllowances    EmployeeAllowance[]
  deductionTypes        DeductionType[]
  employeeDeductions    EmployeeDeduction[]
  payrollPeriods        PayrollPeriod[]
  payrollRuns           PayrollRun[]
  payrollItems          PayrollItem[]
  workOrders            WorkOrder[]
  complaints            Complaint[]
  assetCategories       AssetCategory[]
  depreciationRuns      DepreciationRun[]
  assetTransfers        AssetTransfer[]

  @@map("organizations")
}

/// Exactly one row per organization (enforced by the unique
/// organization_id). Org-wide configuration.
model OrganizationSettings {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @unique @map("organization_id") @db.Uuid
  legalName              String   @map("legal_name") @db.VarChar(255)
  /// ISO 4217 code. Plain text for now — see reconciliation note at top
  /// of file re: deferred currencies table.
  defaultCurrencyCode    String   @default("PHP") @map("default_currency_code") @db.VarChar(3)
  fiscalYearStartMonth   Int      @default(1) @map("fiscal_year_start_month") @db.SmallInt
  timezone               String   @default("Asia/Manila") @db.VarChar(50)
  // Configurable "District Profile" — shown on printed forms and headings.
  address                String?  @db.VarChar(500)
  contact                String?  @db.VarChar(255)
  logoUrl                String?  @map("logo_url") @db.VarChar(1000)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?  @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  updater      User?         @relation("OrganizationSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("organization_settings")
}

/// Generic hierarchical org-unit tree (any level: division, section,
/// office, etc.). `departments` and `responsibility_centers` are
/// specific specializations that each hang off a node in this tree,
/// rather than each maintaining their own separate hierarchy.
model OrganizationalUnit {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  parentUnitId   String?                @map("parent_unit_id") @db.Uuid
  unitType       OrganizationalUnitType @map("unit_type")
  code           String                 @db.VarChar(20)
  name           String                 @db.VarChar(255)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentUnit   OrganizationalUnit?  @relation("OrgUnitHierarchy", fields: [parentUnitId], references: [id], onDelete: Restrict)
  childUnits   OrganizationalUnit[] @relation("OrgUnitHierarchy")

  departments           Department[]
  responsibilityCenters ResponsibilityCenter[]
  userRoles             UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentUnitId])
  @@map("organizational_units")
}

/// The formal, HR-recognized "Department" level of the org chart — a
/// specific specialization of OrganizationalUnit, not a parallel
/// hierarchy of its own.
model Department {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  organizationalUnitId String   @unique @map("organizational_unit_id") @db.Uuid
  code                 String   @db.VarChar(20)
  name                 String   @db.VarChar(255)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  purchaseRequests      PurchaseRequest[]
  ppmpItems             PpmpItem[]
  delegationAuthorities DelegationAuthority[]
  obligationRequests    ObligationRequest[]
  requisitionIssueSlips RequisitionIssueSlip[]
  employees             Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

/// Budgetary/accountability center — may map to any level of the
/// organizational unit tree, not necessarily a full Department.
model ResponsibilityCenter {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  organizationalUnitId String   @map("organizational_unit_id") @db.Uuid
  code                 String   @db.VarChar(20)
  name                 String   @db.VarChar(255)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationalUnit OrganizationalUnit @relation(fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  budgetHeaders    BudgetHeader[]
  purchaseRequests   PurchaseRequest[]
  cafs               CertificationOfAvailability[]
  obligationRequests   ObligationRequest[]
  disbursementVouchers DisbursementVoucher[]
  journalEntryVouchers JournalEntryVoucher[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationalUnitId])
  @@map("responsibility_centers")
}

/// Physical location master (offices, warehouses-to-be, sites) — generic
/// enough to be reused by future Inventory/HR modules without
/// duplicating an address table per module.
model Location {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(255)
  addressLine1   String?  @map("address_line1") @db.VarChar(255)
  addressLine2   String?  @map("address_line2") @db.VarChar(255)
  city           String?  @db.VarChar(100)
  region         String?  @db.VarChar(100)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  purchaseRequests      PurchaseRequest[]
  propertyRecords       PropertyRecord[]
  assetTransfersFrom    AssetTransfer[]    @relation("AssetTransfersFromLocation")
  assetTransfersTo      AssetTransfer[]    @relation("AssetTransfersToLocation")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("locations")
}

// ════════════════════════════════════════════════════════════════════
// IDENTITY & ACCESS
