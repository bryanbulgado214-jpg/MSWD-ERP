  materialsCost         Decimal           @default(0) @map("materials_cost") @db.Decimal(14, 2)
  createdBy             String?           @map("created_by") @db.Uuid
  updatedBy             String?           @map("updated_by") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version               Int               @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer     Consumer?    @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  meter        Meter?       @relation(fields: [meterId], references: [id], onDelete: SetNull)
  assignee     Employee?    @relation("WorkOrderAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  verifier     User?        @relation("WorkOrdersVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  creator      User?        @relation("WorkOrdersCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("WorkOrdersUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  materials  WorkOrderMaterial[]
  notes      WorkOrderNote[]
  complaints Complaint[]

  @@unique([organizationId, woNumber])
  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([assignedTo])
  @@index([consumerId])
  @@index([scheduledDate])
  @@map("work_orders")
}

model WorkOrderMaterial {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId     String   @map("work_order_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  quantityUsed    Decimal  @map("quantity_used") @db.Decimal(12, 4)
  unitCost        Decimal  @default(0) @map("unit_cost") @db.Decimal(18, 2)
  totalCost       Decimal  @default(0) @map("total_cost") @db.Decimal(18, 2)
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@map("work_order_materials")
}

model WorkOrderNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  note        String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  author    User?     @relation("WorkOrderNotesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@map("work_order_notes")
}

// ─── Customer Service & Complaints ───

enum ComplaintType {
  water_quality
  billing_dispute
  service_interruption
  leak_report
  meter_issue
  low_pressure
  no_water
  illegal_connection
  staff_conduct
  other

  @@map("complaint_type")
}

enum ComplaintPriority {
  low
  normal
  high
  urgent

  @@map("complaint_priority")
}

enum ComplaintStatus {
  open
  assigned
  in_progress
  resolved
  closed
  reopened

  @@map("complaint_status")
}

enum ComplaintResolutionType {
  fixed
  explained
  referred
  no_action_needed
  duplicate
  invalid

  @@map("complaint_resolution_type")
}

model Complaint {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  complaintNumber String              @map("complaint_number") @db.VarChar(20)
  type            ComplaintType
  priority        ComplaintPriority    @default(normal)
  status          ComplaintStatus      @default(open)
  subject         String              @db.VarChar(200)
  description     String
  location        String?             @db.VarChar(300)
  contactName     String?             @map("contact_name") @db.VarChar(150)
  contactPhone    String?             @map("contact_phone") @db.VarChar(30)
  contactEmail    String?             @map("contact_email") @db.VarChar(150)
  consumerId      String?             @map("consumer_id") @db.Uuid
  assignedTo      String?             @map("assigned_to") @db.Uuid
  assignedAt      DateTime?           @map("assigned_at") @db.Timestamptz(6)
  resolutionType  ComplaintResolutionType? @map("resolution_type")
  resolutionNotes String?             @map("resolution_notes")
  resolvedAt      DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedBy      String?             @map("resolved_by") @db.Uuid
  closedAt        DateTime?           @map("closed_at") @db.Timestamptz(6)
  closedBy        String?             @map("closed_by") @db.Uuid
  slaDueAt        DateTime?           @map("sla_due_at") @db.Timestamptz(6)
  workOrderId     String?             @map("work_order_id") @db.Uuid
  version         Int                 @default(1)
  createdBy       String?             @map("created_by") @db.Uuid
  updatedBy       String?             @map("updated_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer     Consumer?    @relation(fields: [consumerId], references: [id], onDelete: SetNull)
  assignee     Employee?    @relation("ComplaintAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  resolver     User?        @relation("ComplaintsResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)
  closer       User?        @relation("ComplaintsClosedBy", fields: [closedBy], references: [id], onDelete: SetNull)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  creator      User?        @relation("ComplaintsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("ComplaintsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  notes        ComplaintNote[]
  attachments  ComplaintAttachment[]

  @@unique([organizationId, complaintNumber])
  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([organizationId, priority])
  @@index([consumerId])
  @@index([assignedTo])
  @@index([workOrderId])
  @@index([createdAt])
  @@index([slaDueAt])
  @@map("complaints")
}

model ComplaintNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  note        String
  isInternal  Boolean  @default(false) @map("is_internal")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User?     @relation("ComplaintNotesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@map("complaint_notes")
}

model ComplaintAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  fileName    String   @map("file_name") @db.VarChar(255)
  fileType    String?  @map("file_type") @db.VarChar(100)
  fileSize    Int?     @map("file_size")
  filePath    String   @map("file_path") @db.VarChar(500)
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  uploader  User?     @relation("ComplaintAttachmentsUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([complaintId])
  @@map("complaint_attachments")
}

// ─── Asset Management ─────────────────────────────────────────

enum DepreciationRunStatus {
  draft
  posted
  voided

  @@map("depreciation_run_status")
}

enum AssetTransferStatus {
  pending
  approved
  completed
  rejected

  @@map("asset_transfer_status")
}

enum DepreciationMethod {
  straight_line

  @@map("depreciation_method")
}

model AssetCategory {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  code                  String              @db.VarChar(20)
  name                  String              @db.VarChar(200)
  description           String?
  depreciationMethod    DepreciationMethod   @default(straight_line) @map("depreciation_method")
  defaultUsefulLife     Int?                @map("default_useful_life")
  ppeAccountCode        String?             @map("ppe_account_code") @db.VarChar(20)
  accumDeprAccountCode  String?             @map("accum_depr_account_code") @db.VarChar(20)
  deprExpenseAccountCode String?            @map("depr_expense_account_code") @db.VarChar(20)
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  propertyRecords      PropertyRecord[]
  depreciationRunItems DepreciationRunItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("asset_categories")
}

model DepreciationRun {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  runNumber         String                @map("run_number") @db.VarChar(30)
  periodMonth       Int                   @map("period_month")
  periodYear        Int                   @map("period_year")
  status            DepreciationRunStatus @default(draft)
  totalDepreciation Decimal               @default(0) @map("total_depreciation") @db.Decimal(18, 2)
  assetCount        Int                   @default(0) @map("asset_count")
  jevId             String?               @map("jev_id") @db.Uuid
  postedBy          String?               @map("posted_by") @db.Uuid
  postedAt          DateTime?             @map("posted_at") @db.Timestamptz(6)
  voidedBy          String?               @map("voided_by") @db.Uuid
  voidedAt          DateTime?             @map("voided_at") @db.Timestamptz(6)
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  version           Int                   @default(1)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jev          JournalEntryVoucher?  @relation(fields: [jevId], references: [id], onDelete: SetNull)
  poster       User?                 @relation("DepreciationRunsPostedBy", fields: [postedBy], references: [id], onDelete: SetNull)
  voider       User?                 @relation("DepreciationRunsVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  creator      User?                 @relation("DepreciationRunsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  items DepreciationRunItem[]

  @@unique([organizationId, periodMonth, periodYear])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("depreciation_runs")
}

model DepreciationRunItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  depreciationRunId  String   @map("depreciation_run_id") @db.Uuid
  propertyRecordId   String   @map("property_record_id") @db.Uuid
  assetCategoryId    String?  @map("asset_category_id") @db.Uuid
  depreciationAmount Decimal  @map("depreciation_amount") @db.Decimal(18, 2)
  accumBefore        Decimal  @map("accum_before") @db.Decimal(18, 2)
  accumAfter         Decimal  @map("accum_after") @db.Decimal(18, 2)
  bookValueBefore    Decimal  @map("book_value_before") @db.Decimal(18, 2)
  bookValueAfter     Decimal  @map("book_value_after") @db.Decimal(18, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  depreciationRun DepreciationRun @relation(fields: [depreciationRunId], references: [id], onDelete: Cascade)
  propertyRecord  PropertyRecord  @relation(fields: [propertyRecordId], references: [id], onDelete: Restrict)
  assetCategory   AssetCategory?  @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)

  @@index([depreciationRunId])
  @@index([propertyRecordId])
  @@map("depreciation_run_items")
}

model AssetTransfer {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  transferNumber   String              @map("transfer_number") @db.VarChar(30)
  propertyRecordId String              @map("property_record_id") @db.Uuid
  fromUserId       String?             @map("from_user_id") @db.Uuid
  toUserId         String              @map("to_user_id") @db.Uuid
  fromLocationId   String?             @map("from_location_id") @db.Uuid
  toLocationId     String?             @map("to_location_id") @db.Uuid
  transferDate     DateTime            @default(now()) @map("transfer_date") @db.Timestamptz(6)
  reason           String?
  status           AssetTransferStatus @default(pending)
  approvedBy       String?             @map("approved_by") @db.Uuid
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(6)
  completedAt      DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  version          Int                 @default(1)

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  propertyRecord PropertyRecord @relation(fields: [propertyRecordId], references: [id], onDelete: Restrict)
  fromUser       User?          @relation("AssetTransfersFrom", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser         User           @relation("AssetTransfersTo", fields: [toUserId], references: [id], onDelete: Restrict)
  fromLocation   Location?      @relation("AssetTransfersFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     Location?      @relation("AssetTransfersToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  approver       User?          @relation("AssetTransfersApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator        User?          @relation("AssetTransfersCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, transferNumber])
  @@index([organizationId])
  @@index([propertyRecordId])
  @@index([organizationId, status])
  @@map("asset_transfers")
}
