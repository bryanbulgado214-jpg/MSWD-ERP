}

enum CafStatus {
  draft
  for_certification
  certified
  rejected
  cancelled
  superseded

  @@map("caf_status")
}

enum OrsStatus {
  draft
  for_requesting_certification
  for_budget_certification
  obligated
  partially_payable
  partially_paid
  fully_paid
  adjusted
  cancelled
  closed

