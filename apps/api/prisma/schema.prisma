  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  inspectionReport     InspectionReport?     @relation(fields: [inspectionReportId], references: [id], onDelete: SetNull)
  fundSource           FundSource?           @relation(fields: [fundSourceId], references: [id], onDelete: Restrict)
  responsibilityCenter ResponsibilityCenter? @relation(fields: [responsibilityCenterId], references: [id], onDelete: Restrict)
  certifier            User?                 @relation("DvsCertifiedBy", fields: [certifiedBy], references: [id], onDelete: SetNull)
  approver             User?                 @relation("DvsApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  releaser             User?                 @relation("DvsReleasedBy", fields: [releasedBy], references: [id], onDelete: SetNull)
  creator              User                  @relation("DvsCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updater              User                  @relation("DvsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict)

  checks               Check[]

  @@unique([organizationId, dvNumber])
  @@index([organizationId, status])
  @@index([orsId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("disbursement_vouchers")
}

// ════════════════════════════════════════════════════════════════════
// INVENTORY & PROPERTY MANAGEMENT
//
// Implements the Supply & Property Management module per:
//   - COA Circular 2024-006 / 2022-004 (₱50,000 PPE threshold,
//     3-tier item classification)
//   - GAM Appendices 57-74 (Stock Card, RIS, PAR, ICS, RPCI, etc.)
//   - PD 1445 (Government Auditing Code)
//   - R.A. 9184 (Government Procurement Reform Act)
//
// Classification tiers (COA Circular 2024-006):
//   expendable      — Supplies consumed in use
//   semi_expendable — ₱5,000 to <₱50,000, useful life >1 year (ICS)
//   ppe             — ≥₱50,000, useful life >1 year (PAR)
//
// Valuation: Weighted average cost method per COA rules.
// Physical count: Semi-annual for supplies, annual for PPE.
// ════════════════════════════════════════════════════════════════════

enum InventoryClassification {
  expendable
  semi_expendable
  ppe

  @@map("inventory_classification")
}

enum StockReceiptStatus {
  draft
  received
  cancelled

  @@map("stock_receipt_status")
}

enum StockCardEntryType {
  receipt
  issue
  return_entry
  adjustment
  beginning_balance

  @@map("stock_card_entry_type")
}

enum RisStatus {
  draft
  submitted
  approved
  issued
  partially_issued
  cancelled

  @@map("ris_status")
}

enum AccountabilityType {
  par
  ics

  @@map("accountability_type")
}

enum AccountabilityStatus {
  active
  returned
  transferred
  disposed
  lost

  @@map("accountability_status")
}

enum PropertyCondition {
  brand_new
  serviceable
  unserviceable
  poor
  beyond_repair

  @@map("property_condition")
}

enum PhysicalCountStatus {
  draft
  in_progress
  completed
  approved

  @@map("physical_count_status")
}

enum CountType {
  semi_annual_supplies
  annual_ppe
  annual_semi_expendable
  spot_check

  @@map("count_type")
}

enum DisposalStatus {
  draft
  for_appraisal
  appraised
  for_approval
  approved
  disposed
  cancelled

  @@map("disposal_status")
}

enum DisposalMethod {
  public_auction
  negotiated_sale
  barter
  donation
  destruction
  transfer_to_agency

  @@map("disposal_method")
}

/// Master catalog of inventory items. Each item is classified as
/// expendable, semi-expendable, or PPE per COA Circular 2024-006.
/// on_hand_quantity and unit_cost are maintained by the system via
/// stock card entries (weighted average cost method).
model InventoryItem {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  itemCode            String                  @map("item_code") @db.VarChar(50)
  description         String                  @db.VarChar(500)
  unitOfMeasure       String                  @map("unit_of_measure") @db.VarChar(30)
  classification      InventoryClassification
  category            String?                 @db.VarChar(100)
  accountCode         String?                 @map("account_code") @db.VarChar(30)
  reorderPoint        Decimal                 @default(0) @map("reorder_point") @db.Decimal(12, 4)
  unitCost            Decimal                 @default(0) @map("unit_cost") @db.Decimal(18, 2)
  onHandQuantity      Decimal                 @default(0) @map("on_hand_quantity") @db.Decimal(12, 4)
  isActive            Boolean                 @default(true) @map("is_active")
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?                 @map("created_by") @db.Uuid
  updatedBy           String?                 @map("updated_by") @db.Uuid
  version             Int                     @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User?        @relation("InventoryItemsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("InventoryItemsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  stockCard            StockCard?
  stockReceiptItems    StockReceiptItem[]
  risItems             RisItem[]
  propertyRecords      PropertyRecord[]
  physicalCountItems   PhysicalCountItem[]
  workOrderMaterials   WorkOrderMaterial[]

  @@unique([organizationId, itemCode])
  @@index([organizationId])
  @@index([classification])
  @@index([isActive])
  @@map("inventory_items")
}

/// Goods received into inventory, typically from a PO after inspection
/// (IAR). Links to PurchaseOrder and InspectionReport for traceability.
model StockReceipt {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  receiptNumber      String             @map("receipt_number") @db.VarChar(30)
  receiptDate        DateTime           @map("receipt_date") @db.Date
  purchaseOrderId    String?            @map("purchase_order_id") @db.Uuid
  inspectionReportId String?            @map("inspection_report_id") @db.Uuid
  supplierId         String?            @map("supplier_id") @db.Uuid
  status             StockReceiptStatus @default(draft)
  receivedBy         String?            @map("received_by") @db.Uuid
  remarks            String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid
  version            Int                @default(1)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  inspectionReport InspectionReport? @relation(fields: [inspectionReportId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  receiver         User?             @relation("StockReceiptsReceivedBy", fields: [receivedBy], references: [id], onDelete: SetNull)
  creator          User?             @relation("StockReceiptsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater          User?             @relation("StockReceiptsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items StockReceiptItem[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([inspectionReportId])
  @@index([status])
  @@map("stock_receipts")
}

/// Line item of a stock receipt — quantity and cost of each item received.
model StockReceiptItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockReceiptId  String   @map("stock_receipt_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  quantityReceived Decimal @map("quantity_received") @db.Decimal(12, 4)
  unitCost        Decimal  @map("unit_cost") @db.Decimal(18, 2)
  totalCost       Decimal  @map("total_cost") @db.Decimal(18, 2)
  lotNumber       String?  @map("lot_number") @db.VarChar(50)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  stockReceipt  StockReceipt  @relation(fields: [stockReceiptId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  propertyRecords PropertyRecord[]

  @@index([stockReceiptId])
  @@index([inventoryItemId])
  @@map("stock_receipt_items")
}

/// Stock Card per inventory item (GAM Appendix 58). Maintains the
/// running balance for weighted average cost valuation. One card per
/// item; entries below record every receipt, issue, return, and
/// adjustment.
model StockCard {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  inventoryItemId String   @unique @map("inventory_item_id") @db.Uuid
  stockNumber     String   @map("stock_number") @db.VarChar(50)
  description     String   @db.VarChar(500)
  reorderPoint    Decimal  @default(0) @map("reorder_point") @db.Decimal(12, 4)
  unitOfMeasure   String   @map("unit_of_measure") @db.VarChar(30)
  balanceQuantity Decimal  @default(0) @map("balance_quantity") @db.Decimal(12, 4)
  balanceUnitCost Decimal  @default(0) @map("balance_unit_cost") @db.Decimal(18, 2)
  balanceTotalCost Decimal @default(0) @map("balance_total_cost") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  entries StockCardEntry[]

  @@index([organizationId])
  @@map("stock_cards")
}

/// Individual entry on a Stock Card — each receipt, issue, return, or
/// adjustment is one row. balance_* columns record the running balance
/// AFTER this entry (same layout as the physical Appendix 58 form).
model StockCardEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stockCardId      String             @map("stock_card_id") @db.Uuid
  entryDate        DateTime           @map("entry_date") @db.Date
  entryType        StockCardEntryType @map("entry_type")
  referenceType    String?            @map("reference_type") @db.VarChar(50)
  referenceId      String?            @map("reference_id") @db.Uuid
  referenceNumber  String?            @map("reference_number") @db.VarChar(50)
  receiptQuantity  Decimal?           @map("receipt_quantity") @db.Decimal(12, 4)
  receiptUnitCost  Decimal?           @map("receipt_unit_cost") @db.Decimal(18, 2)
  receiptTotalCost Decimal?           @map("receipt_total_cost") @db.Decimal(18, 2)
  issueQuantity    Decimal?           @map("issue_quantity") @db.Decimal(12, 4)
  issueUnitCost    Decimal?           @map("issue_unit_cost") @db.Decimal(18, 2)
  issueTotalCost   Decimal?           @map("issue_total_cost") @db.Decimal(18, 2)
  balanceQuantity  Decimal            @map("balance_quantity") @db.Decimal(12, 4)
  balanceUnitCost  Decimal            @map("balance_unit_cost") @db.Decimal(18, 2)
  balanceTotalCost Decimal            @map("balance_total_cost") @db.Decimal(18, 2)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?            @map("created_by") @db.Uuid

  stockCard StockCard @relation(fields: [stockCardId], references: [id], onDelete: Restrict)
  creator   User?     @relation("StockCardEntriesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([stockCardId])
  @@index([entryDate])
  @@index([referenceType, referenceId])
  @@map("stock_card_entries")
}

/// Requisition and Issue Slip (GAM Appendix 63). A department requests
/// supplies; the Supply Officer approves and issues them.
model RequisitionIssueSlip {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  risNumber              String    @map("ris_number") @db.VarChar(30)
  risDate                DateTime  @map("ris_date") @db.Date
  requestingDepartmentId String    @map("requesting_department_id") @db.Uuid
  purpose                String?
  status                 RisStatus @default(draft)
  requestedBy            String?   @map("requested_by") @db.Uuid
  approvedBy             String?   @map("approved_by") @db.Uuid
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  issuedBy               String?   @map("issued_by") @db.Uuid
  issuedAt               DateTime? @map("issued_at") @db.Timestamptz(6)
  remarks                String?
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  version                Int       @default(1)

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestingDepartment Department   @relation(fields: [requestingDepartmentId], references: [id], onDelete: Restrict)
  requester            User?        @relation("RisRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  approver             User?        @relation("RisApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  issuer               User?        @relation("RisIssuedBy", fields: [issuedBy], references: [id], onDelete: SetNull)
  creator              User?        @relation("RisCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater              User?        @relation("RisUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items RisItem[]

  @@unique([organizationId, risNumber])
  @@index([organizationId])
  @@index([requestingDepartmentId])
  @@index([status])
  @@map("requisition_issue_slips")
}

/// Line item on an RIS — what was requested and what was actually issued.
model RisItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  risId            String  @map("ris_id") @db.Uuid
  inventoryItemId  String  @map("inventory_item_id") @db.Uuid
  stockNumber      String  @map("stock_number") @db.VarChar(50)
  description      String  @db.VarChar(500)
  unitOfMeasure    String  @map("unit_of_measure") @db.VarChar(30)
  quantityRequested Decimal @map("quantity_requested") @db.Decimal(12, 4)
  quantityIssued   Decimal @default(0) @map("quantity_issued") @db.Decimal(12, 4)
  unitCost         Decimal @default(0) @map("unit_cost") @db.Decimal(18, 2)
  remarks          String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ris           RequisitionIssueSlip @relation(fields: [risId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([risId])
  @@index([inventoryItemId])
  @@map("ris_items")
}

/// Individual PPE or semi-expendable item tracked with a unique property
/// number. Created when a stock receipt for a PPE/semi-expendable item
/// is posted. Tracks condition, location, accountable person, and
/// depreciation data for PPE items.
model PropertyRecord {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  inventoryItemId     String            @map("inventory_item_id") @db.Uuid
  stockReceiptItemId  String?           @map("stock_receipt_item_id") @db.Uuid
  propertyNumber      String            @map("property_number") @db.VarChar(50)
  serialNumber        String?           @map("serial_number") @db.VarChar(100)
  description         String            @db.VarChar(500)
  dateAcquired        DateTime          @map("date_acquired") @db.Date
  acquisitionCost     Decimal           @map("acquisition_cost") @db.Decimal(18, 2)
  estimatedUsefulLife Int?              @map("estimated_useful_life")
  salvageValue        Decimal?          @map("salvage_value") @db.Decimal(18, 2)
  monthlyDepreciation Decimal?          @map("monthly_depreciation") @db.Decimal(18, 2)
  accumulatedDepreciation Decimal       @default(0) @map("accumulated_depreciation") @db.Decimal(18, 2)
  bookValue           Decimal?          @map("book_value") @db.Decimal(18, 2)
  condition           PropertyCondition @default(brand_new)
  locationId          String?           @map("location_id") @db.Uuid
  accountableUserId   String?           @map("accountable_user_id") @db.Uuid
  isDisposed          Boolean           @default(false) @map("is_disposed")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?           @map("created_by") @db.Uuid
  updatedBy           String?           @map("updated_by") @db.Uuid
  version             Int               @default(1)

  assetCategoryId     String?           @map("asset_category_id") @db.Uuid

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockReceiptItem StockReceiptItem? @relation(fields: [stockReceiptItemId], references: [id], onDelete: SetNull)
  location         Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  accountableUser  User?             @relation("PropertyRecordsAccountable", fields: [accountableUserId], references: [id], onDelete: SetNull)
  creator          User?             @relation("PropertyRecordsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater          User?             @relation("PropertyRecordsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  assetCategory    AssetCategory?    @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)

  accountabilityItems   AccountabilityRecordItem[]
  physicalCountItems    PhysicalCountItem[]
  disposalItems         DisposalRequestItem[]
  depreciationRunItems  DepreciationRunItem[]
  assetTransfers        AssetTransfer[]

  @@unique([organizationId, propertyNumber])
  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([accountableUserId])
  @@index([locationId])
  @@index([condition])
  @@index([isDisposed])
  @@index([assetCategoryId])
  @@map("property_records")
}

/// PAR or ICS document header. A PAR (Property Acknowledgment Receipt)
/// is issued for PPE items (≥₱50,000). An ICS (Inventory Custodian
/// Slip) is issued for semi-expendable items (₱5,000 to <₱50,000).
model AccountabilityRecord {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  accountabilityType   AccountabilityType   @map("accountability_type")
  accountabilityNumber String               @map("accountability_number") @db.VarChar(30)
  issuedToUserId       String               @map("issued_to_user_id") @db.Uuid
  issuedDate           DateTime             @map("issued_date") @db.Date
  returnDate           DateTime?            @map("return_date") @db.Date
  status               AccountabilityStatus @default(active)
  parRenewalDate       DateTime?            @map("par_renewal_date") @db.Date
  issuedBy             String?              @map("issued_by") @db.Uuid
  remarks              String?
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?              @map("created_by") @db.Uuid
  updatedBy            String?              @map("updated_by") @db.Uuid
  version              Int                  @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  issuedTo     User         @relation("AccountabilitiesIssuedTo", fields: [issuedToUserId], references: [id], onDelete: Restrict)
  issuer       User?        @relation("AccountabilitiesIssuedBy", fields: [issuedBy], references: [id], onDelete: SetNull)
  creator      User?        @relation("AccountabilitiesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("AccountabilitiesUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items AccountabilityRecordItem[]

  @@unique([organizationId, accountabilityNumber])
  @@index([organizationId])
  @@index([issuedToUserId])
  @@index([accountabilityType])
  @@index([status])
  @@map("accountability_records")
}

/// Line item on a PAR or ICS — links a property record to the
/// accountability document.
model AccountabilityRecordItem {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountabilityRecordId String  @map("accountability_record_id") @db.Uuid
  propertyRecordId       String  @map("property_record_id") @db.Uuid
  quantity               Decimal @default(1) @db.Decimal(12, 4)
  unitCost               Decimal @map("unit_cost") @db.Decimal(18, 2)
  totalCost              Decimal @map("total_cost") @db.Decimal(18, 2)
  remarks                String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  accountabilityRecord AccountabilityRecord @relation(fields: [accountabilityRecordId], references: [id], onDelete: Cascade)
  propertyRecord       PropertyRecord       @relation(fields: [propertyRecordId], references: [id], onDelete: Restrict)

  @@index([accountabilityRecordId])
  @@index([propertyRecordId])
  @@map("accountability_record_items")
}

/// Physical count event. Semi-annual for supplies, annual for PPE/
/// semi-expendable, per COA rules.
model PhysicalCount {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  countNumber    String             @map("count_number") @db.VarChar(30)
  countDate      DateTime           @map("count_date") @db.Date
  countType      CountType          @map("count_type")
  fiscalYearId   String?            @map("fiscal_year_id") @db.Uuid
  status         PhysicalCountStatus @default(draft)
  countedBy      String?            @map("counted_by") @db.Uuid
  verifiedBy     String?            @map("verified_by") @db.Uuid
  approvedBy     String?            @map("approved_by") @db.Uuid
  approvedAt     DateTime?          @map("approved_at") @db.Timestamptz(6)
  remarks        String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?            @map("created_by") @db.Uuid
  updatedBy      String?            @map("updated_by") @db.Uuid
  version        Int                @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear?  @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  counter      User?        @relation("PhysicalCountsCountedBy", fields: [countedBy], references: [id], onDelete: SetNull)
  verifier     User?        @relation("PhysicalCountsVerifiedBy", fields: [verifiedBy], references: [id], onDelete: SetNull)
  approver     User?        @relation("PhysicalCountsApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator      User?        @relation("PhysicalCountsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("PhysicalCountsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items PhysicalCountItem[]

  @@unique([organizationId, countNumber])
  @@index([organizationId])
  @@index([countType])
  @@index([status])
  @@map("physical_counts")
}

/// Individual item counted during a physical count. Records the
/// variance between on-hand (counted) and per-card (system) quantities.
model PhysicalCountItem {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  physicalCountId   String           @map("physical_count_id") @db.Uuid
  inventoryItemId   String           @map("inventory_item_id") @db.Uuid
  propertyRecordId  String?          @map("property_record_id") @db.Uuid
  onHandPerCount    Decimal          @map("on_hand_per_count") @db.Decimal(12, 4)
  onHandPerCard     Decimal          @map("on_hand_per_card") @db.Decimal(12, 4)
  quantityVariance  Decimal          @map("quantity_variance") @db.Decimal(12, 4)
  unitCost          Decimal          @map("unit_cost") @db.Decimal(18, 2)
  totalVarianceCost Decimal          @map("total_variance_cost") @db.Decimal(18, 2)
  condition         PropertyCondition?
  remarks           String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  physicalCount  PhysicalCount  @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  propertyRecord PropertyRecord? @relation(fields: [propertyRecordId], references: [id], onDelete: SetNull)

  @@index([physicalCountId])
  @@index([inventoryItemId])
  @@map("physical_count_items")
}

/// Waste Materials Report / Disposal request. Workflow:
/// draft → for_appraisal → appraised → for_approval → approved → disposed
model DisposalRequest {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  requestNumber   String         @map("request_number") @db.VarChar(30)
  requestDate     DateTime       @map("request_date") @db.Date
  status          DisposalStatus @default(draft)
  disposalMethod  DisposalMethod? @map("disposal_method")
  totalAppraised  Decimal?       @map("total_appraised") @db.Decimal(18, 2)
  requestedBy     String?        @map("requested_by") @db.Uuid
  appraisedBy     String?        @map("appraised_by") @db.Uuid
  appraisedAt     DateTime?      @map("appraised_at") @db.Timestamptz(6)
  approvedBy      String?        @map("approved_by") @db.Uuid
  approvedAt      DateTime?      @map("approved_at") @db.Timestamptz(6)
  disposedAt      DateTime?      @map("disposed_at") @db.Timestamptz(6)
  remarks         String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  version         Int            @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester    User?        @relation("DisposalsRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)
  appraiser    User?        @relation("DisposalsAppraisedBy", fields: [appraisedBy], references: [id], onDelete: SetNull)
  approver     User?        @relation("DisposalsApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator      User?        @relation("DisposalsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("DisposalsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items DisposalRequestItem[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId])
  @@index([status])
  @@map("disposal_requests")
}

/// Line item in a disposal request — links a property record to the WMR.
model DisposalRequestItem {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disposalRequestId String           @map("disposal_request_id") @db.Uuid
  propertyRecordId  String           @map("property_record_id") @db.Uuid
  description       String           @db.VarChar(500)
  quantity          Decimal          @default(1) @db.Decimal(12, 4)
  unitOfMeasure     String           @map("unit_of_measure") @db.VarChar(30)
  condition         PropertyCondition
  appraisedValue    Decimal?         @map("appraised_value") @db.Decimal(18, 2)
  remarks           String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  disposalRequest DisposalRequest @relation(fields: [disposalRequestId], references: [id], onDelete: Cascade)
  propertyRecord  PropertyRecord  @relation(fields: [propertyRecordId], references: [id], onDelete: Restrict)

  @@index([disposalRequestId])
  @@index([propertyRecordId])
  @@map("disposal_request_items")
}

// ════════════════════════════════════════════════════════════════════
// ACCOUNTING / GENERAL LEDGER MODULE
//
// Implements the Accounting module per:
//   - COA (Commission on Audit) standards
//   - GAM (Government Accounting Manual) for NGAs
//   - UACS (Unified Accounts Code Structure)
//   - GAM Appendix 41 (Journal Entry Voucher)
//
// JEV is the single entry point for all GL postings. GL and Trial
// Balance are database views (not tables) — always real-time
// aggregates of posted JEVs.
//
// Integration: ORS obligation, DV release, stock receipt posting,
// and RIS issuance each auto-generate JEVs via AccountMapping
// configuration.
// ════════════════════════════════════════════════════════════════════

enum AccountType {
  asset
  liability
  equity
  revenue
  expense

  @@map("account_type")
}

enum NormalBalance {
  debit
  credit

  @@map("normal_balance")
}

enum BankAccountType {
  checking
  savings
  trust

  @@map("bank_account_type")
}

enum BankAccountStatus {
  active
  inactive
  closed

  @@map("bank_account_status")
}

enum JevStatus {
  draft
  for_review
  approved
  posted
  voided
  reversed

  @@map("jev_status")
}

enum JevSourceType {
  manual
  obligation
  disbursement
  stock_receipt
  stock_issue
  adjustment
  closing
  payroll
  work_order
  depreciation
  disposal

  @@map("jev_source_type")
}

enum CheckStatus {
  pending
  assigned
  printed
  released
  cleared
  stale_dated
  spoiled
  voided

  @@map("check_status")
}

enum BankReconciliationStatus {
  draft
  in_progress
  completed
  approved

  @@map("bank_reconciliation_status")
}

enum ReconciliationItemType {
  deposit_in_transit
  outstanding_check
  bank_charge
  bank_credit
  book_error
  bank_error

  @@map("reconciliation_item_type")
}

/// UACS-compliant Chart of Accounts. Self-referencing hierarchy:
/// level 1 = account group (e.g. "Assets"), level 2 = major account
/// (e.g. "Cash and Cash Equivalents"), level 3 = sub-account / detail
/// (e.g. "Cash in Bank - LCCA"). Header accounts (isHeader=true)
/// cannot receive JEV postings.
model ChartOfAccount {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  parentAccountId String?       @map("parent_account_id") @db.Uuid
  accountCode     String        @map("account_code") @db.VarChar(30)
  name            String        @db.VarChar(255)
  accountType     AccountType   @map("account_type")
  normalBalance   NormalBalance @map("normal_balance")
  level           Int           @db.SmallInt
  isHeader        Boolean       @default(false) @map("is_header")
  isActive        Boolean       @default(true) @map("is_active")
  uacsCode        String?       @map("uacs_code") @db.VarChar(30)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid
  version         Int           @default(1)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentAccount ChartOfAccount?  @relation("CoaHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  childAccounts ChartOfAccount[] @relation("CoaHierarchy")
  creator       User?            @relation("ChartOfAccountsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater       User?            @relation("ChartOfAccountsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  jevLines        JevLine[]
  accountMappings AccountMapping[]
  bankAccounts    BankAccount[]    @relation("BankAccountGl")

  @@unique([organizationId, accountCode])
  @@index([organizationId])
  @@index([parentAccountId])
  @@index([accountType])
  @@index([isActive])
  @@map("chart_of_accounts")
}

/// Bank institution master.
model Bank {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(20)
  name           String   @db.VarChar(255)
  branch         String?  @db.VarChar(255)
  swiftCode      String?  @map("swift_code") @db.VarChar(20)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccounts BankAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("banks")
}

/// Organization's bank accounts. Links to a Bank and optionally to a
/// FundSource for fund segregation.
model BankAccount {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  bankId         String            @map("bank_id") @db.Uuid
  fundSourceId   String?           @map("fund_source_id") @db.Uuid
  chartOfAccountId String?         @map("chart_of_account_id") @db.Uuid
  accountNumber  String            @map("account_number") @db.VarChar(50)
  accountName    String            @map("account_name") @db.VarChar(255)
  accountType    BankAccountType   @map("account_type")
  currentBalance Decimal           @default(0) @map("current_balance") @db.Decimal(18, 2)
  status         BankAccountStatus @default(active)
  isDefault      Boolean           @default(false) @map("is_default")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?           @map("created_by") @db.Uuid
  updatedBy      String?           @map("updated_by") @db.Uuid
  version        Int               @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bank         Bank         @relation(fields: [bankId], references: [id], onDelete: Restrict)
  fundSource   FundSource?  @relation(fields: [fundSourceId], references: [id], onDelete: SetNull)
  chartOfAccount ChartOfAccount? @relation("BankAccountGl", fields: [chartOfAccountId], references: [id], onDelete: SetNull)
  creator      User?        @relation("BankAccountsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("BankAccountsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  checks              Check[]
  bankReconciliations BankReconciliation[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([bankId])
  @@index([fundSourceId])
  @@index([status])
  @@map("bank_accounts")
}

/// Configurable mapping from transaction type to COA account. Used by
/// the accounting integration service to determine which accounts to
/// debit/credit when auto-generating JEVs from procurement/inventory
/// events. The accountant configures these — avoids hardcoding UACS
/// codes in application logic.
model AccountMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  mappingKey        String   @map("mapping_key") @db.VarChar(100)
  chartOfAccountId String   @map("chart_of_account_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  chartOfAccount ChartOfAccount @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  creator        User?          @relation("AccountMappingsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater        User?          @relation("AccountMappingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, mappingKey])
  @@index([organizationId])
  @@index([chartOfAccountId])
  @@map("account_mappings")
}

/// Journal Entry Voucher (GAM Appendix 41). The primary accounting
/// document and single entry point for all GL postings. Auto-generated
/// from procurement/inventory events or created manually.
model JournalEntryVoucher {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  jevNumber              String        @map("jev_number") @db.VarChar(30)
  jevDate                DateTime      @map("jev_date") @db.Date
  accountingPeriodId     String        @map("accounting_period_id") @db.Uuid
  sourceType             JevSourceType @map("source_type")
  sourceTable            String?       @map("source_table") @db.VarChar(100)
  sourceId               String?       @map("source_id") @db.Uuid
  particulars            String
  responsibilityCenterId String?       @map("responsibility_center_id") @db.Uuid
  fundSourceId           String?       @map("fund_source_id") @db.Uuid
  totalDebit             Decimal       @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit            Decimal       @default(0) @map("total_credit") @db.Decimal(18, 2)
  status                 JevStatus     @default(draft)
  reviewedBy             String?       @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  postedBy               String?       @map("posted_by") @db.Uuid
  postedAt               DateTime?     @map("posted_at") @db.Timestamptz(6)
  voidedBy               String?       @map("voided_by") @db.Uuid
  voidedAt               DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason             String?       @map("void_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy              String?       @map("created_by") @db.Uuid
  updatedBy              String?       @map("updated_by") @db.Uuid
  reversalOfId           String?       @unique @map("reversal_of_id") @db.Uuid
  version                Int           @default(1)

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountingPeriod     AccountingPeriod      @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  responsibilityCenter ResponsibilityCenter? @relation(fields: [responsibilityCenterId], references: [id], onDelete: SetNull)
  fundSource           FundSource?           @relation(fields: [fundSourceId], references: [id], onDelete: SetNull)
  reviewer             User?                 @relation("JevsReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)
  poster               User?                 @relation("JevsPostedBy", fields: [postedBy], references: [id], onDelete: SetNull)
  voider               User?                 @relation("JevsVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  creator              User?                 @relation("JevsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater              User?                 @relation("JevsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  // A reversing entry points at the original it reverses; `reversedBy` is
  // the inverse (the reversing entry that reversed this one), one-to-one.
  reversalOf           JournalEntryVoucher?  @relation("JevReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy           JournalEntryVoucher?  @relation("JevReversal")

  lines            JevLine[]
  depreciationRuns DepreciationRun[]

  @@unique([organizationId, jevNumber])
  @@index([organizationId])
  @@index([accountingPeriodId])
  @@index([sourceType])
  @@index([sourceTable, sourceId])
  @@index([status])
  @@map("journal_entry_vouchers")
}

/// Individual debit or credit line on a JEV. A line is either a debit
/// or a credit (never both, enforced by CHECK constraint in migration).
model JevLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jevId            String   @map("jev_id") @db.Uuid
  chartOfAccountId String   @map("chart_of_account_id") @db.Uuid
  debitAmount      Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount     Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  description      String?
  subsidiaryRef    String?  @map("subsidiary_ref") @db.VarChar(255)
  subsidiaryRefId  String?  @map("subsidiary_ref_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Bank-reconciliation match: this GL cash line belongs to a match group
  // (a balanced set of bank statement lines + book lines matched together,
  // supporting many-to-many matching).
  matchGroupId String? @map("match_group_id") @db.Uuid

  jev            JournalEntryVoucher @relation(fields: [jevId], references: [id], onDelete: Cascade)
  chartOfAccount ChartOfAccount      @relation(fields: [chartOfAccountId], references: [id], onDelete: Restrict)
  matchGroup     BankMatchGroup?     @relation("JevLineGroup", fields: [matchGroupId], references: [id], onDelete: SetNull)

  @@index([jevId])
  @@index([chartOfAccountId])
  @@index([matchGroupId])
  @@map("jev_lines")
}

/// Check lifecycle. Linked to a DisbursementVoucher and BankAccount.
/// Workflow: assigned → printed → released → cleared (or voided/spoiled
/// at any point, stale_dated after 6 months).
model Check {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String      @map("organization_id") @db.Uuid
  disbursementVoucherId String?     @map("disbursement_voucher_id") @db.Uuid
  bankAccountId         String      @map("bank_account_id") @db.Uuid
  checkNumber           String?     @map("check_number") @db.VarChar(30)
  amount                Decimal     @db.Decimal(18, 2)
  checkDate             DateTime    @map("check_date") @db.Date
  payeeName             String      @map("payee_name") @db.VarChar(255)
  status                CheckStatus @default(assigned)
  printedBy             String?     @map("printed_by") @db.Uuid
  printedAt             DateTime?   @map("printed_at") @db.Timestamptz(6)
  releasedBy            String?     @map("released_by") @db.Uuid
  releasedAt            DateTime?   @map("released_at") @db.Timestamptz(6)
  clearedDate           DateTime?   @map("cleared_date") @db.Date
  voidedBy              String?     @map("voided_by") @db.Uuid
  voidedAt              DateTime?   @map("voided_at") @db.Timestamptz(6)
  voidReason            String?     @map("void_reason")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?     @map("created_by") @db.Uuid
  updatedBy             String?     @map("updated_by") @db.Uuid
  version               Int         @default(1)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  disbursementVoucher DisbursementVoucher? @relation(fields: [disbursementVoucherId], references: [id], onDelete: Restrict)
  bankAccount         BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  releaser            User?                @relation("ChecksReleasedBy", fields: [releasedBy], references: [id], onDelete: SetNull)
  voider              User?                @relation("ChecksVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  creator             User?                @relation("ChecksCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater             User?                @relation("ChecksUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  statusHistory           CheckStatusHistory[]
  bankReconciliationItems BankReconciliationItem[]

  @@unique([organizationId, checkNumber, bankAccountId])
  @@index([organizationId])
  @@index([disbursementVoucherId])
  @@index([bankAccountId])
  @@index([status])
  @@map("checks")
}

/// Append-only lifecycle log for checks. A recorded status change is
/// never edited — same immutability convention as audit_logs and
/// workflow_actions.
model CheckStatusHistory {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkId    String       @map("check_id") @db.Uuid
  fromStatus CheckStatus? @map("from_status")
  toStatus   CheckStatus  @map("to_status")
  changedBy  String       @map("changed_by") @db.Uuid
  changedAt  DateTime     @default(now()) @map("changed_at") @db.Timestamptz(6)
  remarks    String?

  check   Check @relation(fields: [checkId], references: [id], onDelete: Restrict)
  changer User  @relation("CheckStatusChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([checkId])
  @@map("check_status_history")
}

/// Bank Reconciliation Statement header. One per bank account per
/// accounting period. Reconciles book balance (from JEV postings)
/// against bank statement balance.
model BankReconciliation {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  bankAccountId        String                   @map("bank_account_id") @db.Uuid
  accountingPeriodId   String                   @map("accounting_period_id") @db.Uuid
  reconciliationDate   DateTime                 @map("reconciliation_date") @db.Date
  bookBalance          Decimal                  @map("book_balance") @db.Decimal(18, 2)
  bankBalance          Decimal                  @map("bank_balance") @db.Decimal(18, 2)
  adjustedBookBalance  Decimal                  @default(0) @map("adjusted_book_balance") @db.Decimal(18, 2)
  adjustedBankBalance  Decimal                  @default(0) @map("adjusted_bank_balance") @db.Decimal(18, 2)
  difference           Decimal                  @default(0) @db.Decimal(18, 2)
  status               BankReconciliationStatus @default(draft)
  preparedBy           String?                  @map("prepared_by") @db.Uuid
  approvedBy           String?                  @map("approved_by") @db.Uuid
  approvedAt           DateTime?                @map("approved_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy            String?                  @map("created_by") @db.Uuid
  updatedBy            String?                  @map("updated_by") @db.Uuid
  version              Int                      @default(1)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  preparer         User?            @relation("BankReconciliationsPreparedBy", fields: [preparedBy], references: [id], onDelete: SetNull)
  approver         User?            @relation("BankReconciliationsApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator          User?            @relation("BankReconciliationsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater          User?            @relation("BankReconciliationsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  items          BankReconciliationItem[]
  statementLines BankStatementLine[]
  matchGroups    BankMatchGroup[]

  @@unique([organizationId, bankAccountId, accountingPeriodId])
  @@index([organizationId])
  @@index([bankAccountId])
  @@index([accountingPeriodId])
  @@index([status])
  @@map("bank_reconciliations")
}

/// Reconciling item on a Bank Reconciliation Statement — deposits in
/// transit, outstanding checks, bank charges/credits, errors.
model BankReconciliationItem {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankReconciliationId String                 @map("bank_reconciliation_id") @db.Uuid
  itemType             ReconciliationItemType @map("item_type")
  referenceNumber      String?                @map("reference_number") @db.VarChar(50)
  referenceDate        DateTime               @map("reference_date") @db.Date
  amount               Decimal                @db.Decimal(18, 2)
  description          String
  checkId              String?                @map("check_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  bankReconciliation BankReconciliation @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)
  check              Check?             @relation(fields: [checkId], references: [id], onDelete: SetNull)

  @@index([bankReconciliationId])
  @@index([checkId])
  @@map("bank_reconciliation_items")
}

/// A single transaction imported from the bank's CSV statement, for the
/// QuickBooks/Intacct-style match-and-clear reconciliation. `amount` is
/// signed from the bank's perspective (+ money in / deposit, − money out /
/// withdrawal). A bank line belongs to a match group (a balanced set of bank
/// lines + book lines), which supports many-to-many matching.
model BankStatementLine {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankReconciliationId String   @map("bank_reconciliation_id") @db.Uuid
  transactionDate      DateTime @map("transaction_date") @db.Date
  description          String
  referenceNumber      String?  @map("reference_number") @db.VarChar(100)
  amount               Decimal  @db.Decimal(18, 2)
  matchGroupId         String?  @map("match_group_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bankReconciliation BankReconciliation @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)
  matchGroup         BankMatchGroup?    @relation("StatementLineGroup", fields: [matchGroupId], references: [id], onDelete: SetNull)

  @@index([bankReconciliationId])
  @@index([matchGroupId])
  @@map("bank_statement_lines")
}

/// A reconciliation match set — a group of bank statement lines and GL cash
/// (jev) lines matched together as one balanced unit. Supports many-to-many
/// matching: N bank lines ↔ M book lines whose signed totals are equal.
model BankMatchGroup {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankReconciliationId String   @map("bank_reconciliation_id") @db.Uuid
  matchedBy            String?  @map("matched_by") @db.Uuid
  matchedAt            DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bankReconciliation BankReconciliation  @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)
  matcher            User?               @relation("BankMatchGroupsMatchedBy", fields: [matchedBy], references: [id], onDelete: SetNull)
  statementLines     BankStatementLine[] @relation("StatementLineGroup")
  jevLines           JevLine[]           @relation("JevLineGroup")

  @@index([bankReconciliationId])
  @@map("bank_match_groups")
}

// ════════════════════════════════════════════════════════════════════
// BILLING & COLLECTIONS MODULE
// ════════════════════════════════════════════════════════════════════

enum ConsumerType {
  residential
  commercial
  industrial
  government
  bulk

  @@map("consumer_type")
}

enum ConsumerStatus {
  active
  disconnected
  inactive
  closed

  @@map("consumer_status")
}

enum MeterStatus {
  active
  retired
  condemned

  @@map("meter_status")
}

enum MeterSize {
  half_inch
  three_quarter_inch
  one_inch
  one_and_half_inch
  two_inch
  three_inch
  four_inch

  @@map("meter_size")
}

enum BillingPeriodStatus {
  open
  reading
  billing
  closed

  @@map("billing_period_status")
}

enum ReadingStatus {
  pending
  confirmed
  adjusted

  @@map("reading_status")
}

enum BillStatus {
  unpaid
  partial
  paid
  cancelled
  written_off

  @@map("bill_status")
}

enum PaymentMethod {
  cash
  check
  online
  bank_deposit

  @@map("payment_method")
}

enum PaymentStatus {
  valid
  voided

  @@map("payment_status")
}

enum ChargeType {
  water
  environmental
  sewer
  maintenance
  penalty
  senior_discount
  pwd_discount
  adjustment
  arrears
  reconnection
  other

  @@map("charge_type")
}

enum DisconnectionStatus {
  notice_issued
  served
  disconnected
  cancelled
  reconnected

  @@map("disconnection_status")
}

/// Water service consumer / account holder.
model Consumer {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  accountNumber    String         @map("account_number") @db.VarChar(20)
  firstName        String         @map("first_name") @db.VarChar(100)
  middleName       String?        @map("middle_name") @db.VarChar(100)
  lastName         String         @map("last_name") @db.VarChar(100)
  businessName     String?        @map("business_name") @db.VarChar(255)
  consumerType     ConsumerType   @default(residential) @map("consumer_type")
  address          String
  barangay         String?        @db.VarChar(100)
  municipality     String?        @default("Siquijor") @db.VarChar(100)
  province         String?        @default("Siquijor") @db.VarChar(100)
  contactNumber    String?        @map("contact_number") @db.VarChar(20)
  email            String?        @db.VarChar(255)
  isSeniorCitizen  Boolean        @default(false) @map("is_senior_citizen")
  isPwd            Boolean        @default(false) @map("is_pwd")
  status           ConsumerStatus @default(active)
  connectionDate   DateTime?      @map("connection_date") @db.Date
  disconnectionDate DateTime?     @map("disconnection_date") @db.Date
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?        @map("created_by") @db.Uuid
  updatedBy        String?        @map("updated_by") @db.Uuid
  version          Int            @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User?        @relation("ConsumersCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("ConsumersUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  consumerMeters       ConsumerMeter[]
  meterReadings        MeterReading[]
  bills                Bill[]
  payments             Payment[]
  disconnectionOrders  DisconnectionOrder[]
  workOrders           WorkOrder[]
  complaints           Complaint[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId])
  @@index([status])
  @@index([consumerType])
  @@index([lastName])
  @@index([barangay])
  @@map("consumers")
}

/// Water meter registry.
model Meter {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  serialNumber   String      @map("serial_number") @db.VarChar(50)
  brand          String?     @db.VarChar(100)
  size           MeterSize   @default(half_inch)
  status         MeterStatus @default(active)
  initialReading Decimal     @default(0) @map("initial_reading") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?     @map("created_by") @db.Uuid
  updatedBy      String?     @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User?        @relation("MetersCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("MetersUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  consumerMeters ConsumerMeter[]
  meterReadings  MeterReading[]
  workOrders     WorkOrder[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([status])
  @@map("meters")
}

/// Meter-to-consumer assignment history.
model ConsumerMeter {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumerId          String   @map("consumer_id") @db.Uuid
  meterId             String   @map("meter_id") @db.Uuid
  installedDate       DateTime @map("installed_date") @db.Date
  removedDate         DateTime? @map("removed_date") @db.Date
  isCurrent           Boolean  @default(true) @map("is_current")
  installationRemarks String?  @map("installation_remarks")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consumer Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)
  meter    Meter    @relation(fields: [meterId], references: [id], onDelete: Restrict)

  @@index([consumerId])
  @@index([meterId])
  @@map("consumer_meters")
}

/// Rate schedule header — tiered pricing per consumer type.
model RateSchedule {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  name               String       @db.VarChar(100)
  consumerType       ConsumerType @map("consumer_type")
  effectiveDate      DateTime     @map("effective_date") @db.Date
  endDate            DateTime?    @map("end_date") @db.Date
  minimumCharge      Decimal      @default(0) @map("minimum_charge") @db.Decimal(18, 2)
  minimumConsumption Decimal      @default(10) @map("minimum_consumption") @db.Decimal(12, 2)
  environmentalFee   Decimal      @default(0) @map("environmental_fee") @db.Decimal(18, 2)
  sewerCharge        Decimal      @default(0) @map("sewer_charge") @db.Decimal(18, 2)
  maintenanceFee     Decimal      @default(0) @map("maintenance_fee") @db.Decimal(18, 2)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?      @map("created_by") @db.Uuid
  updatedBy          String?      @map("updated_by") @db.Uuid
  version            Int          @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User?        @relation("RateSchedulesCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("RateSchedulesUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  tiers RateTier[]

  @@index([organizationId])
  @@index([consumerType])
  @@index([isActive])
  @@map("rate_schedules")
}

/// Block/tiered rate within a rate schedule.
model RateTier {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rateScheduleId    String  @map("rate_schedule_id") @db.Uuid
  minConsumption    Decimal @map("min_consumption") @db.Decimal(12, 2)
  maxConsumption    Decimal? @map("max_consumption") @db.Decimal(12, 2)
  ratePerCubicMeter Decimal @map("rate_per_cubic_meter") @db.Decimal(18, 4)
  sortOrder         Int     @default(0) @map("sort_order")

  rateSchedule RateSchedule @relation(fields: [rateScheduleId], references: [id], onDelete: Cascade)

  @@index([rateScheduleId])
  @@map("rate_tiers")
}

/// Monthly billing period for water billing.
model BillingPeriod {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  name             String              @db.VarChar(50)
  billingMonth     Int                 @map("billing_month")
  billingYear      Int                 @map("billing_year")
  readingStartDate DateTime?           @map("reading_start_date") @db.Date
  readingEndDate   DateTime?           @map("reading_end_date") @db.Date
  dueDate          DateTime            @map("due_date") @db.Date
  penaltyDate      DateTime            @map("penalty_date") @db.Date
  status           BillingPeriodStatus @default(open)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?             @map("created_by") @db.Uuid
  updatedBy        String?             @map("updated_by") @db.Uuid
  version          Int                 @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creator      User?        @relation("BillingPeriodsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("BillingPeriodsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  meterReadings MeterReading[]
  bills         Bill[]

  @@unique([organizationId, billingMonth, billingYear])
  @@index([organizationId])
  @@index([status])
  @@map("billing_periods")
}

/// Individual meter reading for a consumer in a billing period.
model MeterReading {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  consumerId      String        @map("consumer_id") @db.Uuid
  meterId         String        @map("meter_id") @db.Uuid
  billingPeriodId String        @map("billing_period_id") @db.Uuid
  readingDate     DateTime      @map("reading_date") @db.Date
  previousReading Decimal       @map("previous_reading") @db.Decimal(12, 2)
  currentReading  Decimal       @map("current_reading") @db.Decimal(12, 2)
  consumption     Decimal       @default(0) @db.Decimal(12, 2)
  status          ReadingStatus @default(pending)
  remarks         String?
  readerId        String?       @map("reader_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer      Consumer      @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  meter         Meter         @relation(fields: [meterId], references: [id], onDelete: Restrict)
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  reader        User?         @relation("MeterReadingsReader", fields: [readerId], references: [id], onDelete: SetNull)
  creator       User?         @relation("MeterReadingsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater       User?         @relation("MeterReadingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  bills Bill[]

  @@unique([consumerId, billingPeriodId])
  @@index([organizationId])
  @@index([consumerId])
  @@index([billingPeriodId])
  @@index([status])
  @@map("meter_readings")
}

/// Generated water bill for a consumer.
model Bill {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  billNumber          String     @map("bill_number") @db.VarChar(20)
  consumerId          String     @map("consumer_id") @db.Uuid
  billingPeriodId     String     @map("billing_period_id") @db.Uuid
  meterReadingId      String?    @map("meter_reading_id") @db.Uuid
  previousReading     Decimal    @default(0) @map("previous_reading") @db.Decimal(12, 2)
  currentReading      Decimal    @default(0) @map("current_reading") @db.Decimal(12, 2)
  consumption         Decimal    @default(0) @db.Decimal(12, 2)
  waterCharge         Decimal    @default(0) @map("water_charge") @db.Decimal(18, 2)
  environmentalFee    Decimal    @default(0) @map("environmental_fee") @db.Decimal(18, 2)
  sewerCharge         Decimal    @default(0) @map("sewer_charge") @db.Decimal(18, 2)
  maintenanceFee      Decimal    @default(0) @map("maintenance_fee") @db.Decimal(18, 2)
  penaltyAmount       Decimal    @default(0) @map("penalty_amount") @db.Decimal(18, 2)
  discountAmount      Decimal    @default(0) @map("discount_amount") @db.Decimal(18, 2)
  arrearsAmount       Decimal    @default(0) @map("arrears_amount") @db.Decimal(18, 2)
  otherCharges        Decimal    @default(0) @map("other_charges") @db.Decimal(18, 2)
  totalAmount         Decimal    @default(0) @map("total_amount") @db.Decimal(18, 2)
  amountPaid          Decimal    @default(0) @map("amount_paid") @db.Decimal(18, 2)
  balance             Decimal    @default(0) @db.Decimal(18, 2)
  dueDate             DateTime   @map("due_date") @db.Date
  penaltyDate         DateTime   @map("penalty_date") @db.Date
  status              BillStatus @default(unpaid)
  isSeniorDiscount    Boolean    @default(false) @map("is_senior_discount")
  isPwdDiscount       Boolean    @default(false) @map("is_pwd_discount")
  discountPercentage  Decimal    @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  notes               String?
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy           String?    @map("created_by") @db.Uuid
  updatedBy           String?    @map("updated_by") @db.Uuid
  version             Int        @default(1)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer      Consumer      @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Restrict)
  meterReading  MeterReading? @relation(fields: [meterReadingId], references: [id], onDelete: SetNull)
  creator       User?         @relation("BillsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater       User?         @relation("BillsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  charges            BillCharge[]
  paymentAllocations PaymentAllocation[]

  @@unique([organizationId, billNumber])
  @@unique([consumerId, billingPeriodId])
  @@index([organizationId])
  @@index([consumerId])
  @@index([billingPeriodId])
  @@index([status])
  @@index([dueDate])
  @@map("bills")
}

/// Line item charge on a bill.
model BillCharge {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId      String     @map("bill_id") @db.Uuid
  chargeType  ChargeType @map("charge_type")
  description String     @db.VarChar(255)
  amount      Decimal    @db.Decimal(18, 2)
  sortOrder   Int        @default(0) @map("sort_order")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@map("bill_charges")
}

/// Payment / Official Receipt for water bill collection.
model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  orNumber        String        @map("or_number") @db.VarChar(20)
  consumerId      String        @map("consumer_id") @db.Uuid
  paymentDate     DateTime      @map("payment_date") @db.Date
  totalAmount     Decimal       @map("total_amount") @db.Decimal(18, 2)
  paymentMethod   PaymentMethod @default(cash) @map("payment_method")
  checkNumber     String?       @map("check_number") @db.VarChar(50)
  checkDate       DateTime?     @map("check_date") @db.Date
  bankName        String?       @map("bank_name") @db.VarChar(100)
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  remarks         String?
  status          PaymentStatus @default(valid)
  cashierId       String?       @map("cashier_id") @db.Uuid
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedBy        String?       @map("voided_by") @db.Uuid
  voidReason      String?       @map("void_reason")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedBy       String?       @map("updated_by") @db.Uuid
  version         Int           @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer     Consumer     @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  cashier      User?        @relation("PaymentsCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  voider       User?        @relation("PaymentsVoidedBy", fields: [voidedBy], references: [id], onDelete: SetNull)
  creator      User?        @relation("PaymentsCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("PaymentsUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]

  @@unique([organizationId, orNumber])
  @@index([organizationId])
  @@index([consumerId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

/// Maps a payment to one or more bills it covers.
model PaymentAllocation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  billId        String   @map("bill_id") @db.Uuid
  amountApplied Decimal  @map("amount_applied") @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([billId])
  @@map("payment_allocations")
}

/// Disconnection/reconnection workflow.
model DisconnectionOrder {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  consumerId       String               @map("consumer_id") @db.Uuid
  orderNumber      String               @map("order_number") @db.VarChar(20)
  noticeDate       DateTime             @map("notice_date") @db.Date
  scheduledDate    DateTime             @map("scheduled_date") @db.Date
  totalArrears     Decimal              @default(0) @map("total_arrears") @db.Decimal(18, 2)
  status           DisconnectionStatus  @default(notice_issued)
  servedDate       DateTime?            @map("served_date") @db.Date
  servedBy         String?              @map("served_by") @db.Uuid
  disconnectedDate DateTime?            @map("disconnected_date") @db.Date
  disconnectedBy   String?              @map("disconnected_by") @db.Uuid
  reconnectedDate  DateTime?            @map("reconnected_date") @db.Date
  reconnectedBy    String?              @map("reconnected_by") @db.Uuid
  reconnectionFee  Decimal?             @map("reconnection_fee") @db.Decimal(18, 2)
  cancelledDate    DateTime?            @map("cancelled_date") @db.Date
  cancelledBy      String?              @map("cancelled_by") @db.Uuid
  cancelReason     String?              @map("cancel_reason")
  remarks          String?
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?              @map("created_by") @db.Uuid
  updatedBy        String?              @map("updated_by") @db.Uuid
  version          Int                  @default(1)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  consumer      Consumer     @relation(fields: [consumerId], references: [id], onDelete: Restrict)
  server        User?        @relation("DisconnectionOrdersServedBy", fields: [servedBy], references: [id], onDelete: SetNull)
  disconnector  User?        @relation("DisconnectionOrdersDisconnectedBy", fields: [disconnectedBy], references: [id], onDelete: SetNull)
  reconnector   User?        @relation("DisconnectionOrdersReconnectedBy", fields: [reconnectedBy], references: [id], onDelete: SetNull)
  canceller     User?        @relation("DisconnectionOrdersCancelledBy", fields: [cancelledBy], references: [id], onDelete: SetNull)
  creator       User?        @relation("DisconnectionOrdersCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater       User?        @relation("DisconnectionOrdersUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([consumerId])
  @@index([status])
  @@map("disconnection_orders")
}

// ════════════════════════════════════════════════════════════════════
// HR & PAYROLL MODULE
// ════════════════════════════════════════════════════════════════════

model Position {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(20)
  title          String   @db.VarChar(255)
  salaryGrade    Int?     @map("salary_grade")
  salaryStep     Int?     @default(1) @map("salary_step")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("positions")
}

model SalaryGrade {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  grade          Int
