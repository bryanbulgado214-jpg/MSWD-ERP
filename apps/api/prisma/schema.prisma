/// Login accounts. Never stores a plain-text password — only a hash.
model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  username       String    @db.VarChar(50)
  email          String    @db.VarChar(255)
  /// Bcrypt/argon2 hash — application layer is responsible for hashing;
  /// this column never receives a plain-text value.
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  userRoles                  UserRole[]                @relation("UserRolesForUser")
  grantedUserRoles            UserRole[]                @relation("UserRolesGrantedBy")
  grantedRolePermissions       RolePermission[]         @relation("RolePermissionsGrantedBy")
  auditLogs                   AuditLog[]                @relation("AuditLogsPerformedBy")
  uploadedAttachments          Attachment[]              @relation("AttachmentsUploadedBy")
  authoredComments             Comment[]                @relation("CommentsCreatedBy")
  workflowActions               WorkflowAction[]          @relation("WorkflowActionsActor")
  notifications                  Notification[]
  organizationSettingsUpdates     OrganizationSettings[]   @relation("OrganizationSettingsUpdatedBy")
  systemSettingsUpdates            SystemSetting[]         @relation("SystemSettingsUpdatedBy")
  createdBudgetCycles                BudgetCycle[]         @relation("BudgetCyclesCreatedBy")
  updatedBudgetCycles                BudgetCycle[]         @relation("BudgetCyclesUpdatedBy")
  createdBudgetVersions               BudgetVersion[]      @relation("BudgetVersionsCreatedBy")
  updatedBudgetVersions               BudgetVersion[]      @relation("BudgetVersionsUpdatedBy")
  createdBudgetHeaders                 BudgetHeader[]      @relation("BudgetHeadersCreatedBy")
  updatedBudgetHeaders                 BudgetHeader[]      @relation("BudgetHeadersUpdatedBy")
  createdBudgetLines                    BudgetLine[]       @relation("BudgetLinesCreatedBy")
  updatedBudgetLines                    BudgetLine[]       @relation("BudgetLinesUpdatedBy")
  createdBudgetReleases                   BudgetRelease[]     @relation("BudgetReleasesCreatedBy")
  updatedBudgetReleases                   BudgetRelease[]     @relation("BudgetReleasesUpdatedBy")
  createdBudgetReservations                 BudgetReservation[] @relation("BudgetReservationsCreatedBy")
  updatedBudgetReservations                 BudgetReservation[] @relation("BudgetReservationsUpdatedBy")
  budgetTransactionLogs                       BudgetTransactionLog[] @relation("BudgetTransactionLogsCreatedBy")
  createdPurchaseRequests                       PurchaseRequest[] @relation("PurchaseRequestsCreatedBy")
  updatedPurchaseRequests                       PurchaseRequest[] @relation("PurchaseRequestsUpdatedBy")
  departmentHeadPurchaseRequests                PurchaseRequest[] @relation("PurchaseRequestsDeptHead")
  budgetCertifiedPurchaseRequests               PurchaseRequest[] @relation("PurchaseRequestsBudgetCertifiedBy")
  approvedPurchaseRequests                      PurchaseRequest[] @relation("PurchaseRequestsApprovedBy")
  endorsedPurchaseRequests                      PurchaseRequest[] @relation("PurchaseRequestsEndorsedBy")
  createdPpmpItems                              PpmpItem[]        @relation("PpmpItemsCreatedBy")
  updatedPpmpItems                              PpmpItem[]        @relation("PpmpItemsUpdatedBy")
  approvedPpmpItems                             PpmpItem[]        @relation("PpmpItemsApprovedBy")
  assignedPpmpItems                             PpmpItem[]        @relation("PpmpItemsAssignedTo")
  createdAppItems                               AppItem[]         @relation("AppItemsCreatedBy")
  updatedAppItems                               AppItem[]         @relation("AppItemsUpdatedBy")
  createdPrRevisions                            PrRevision[]      @relation("PrRevisionsCreatedBy")
  delegationsGiven                              DelegationAuthority[] @relation("DelegationsGiven")
  delegationsReceived                           DelegationAuthority[] @relation("DelegationsReceived")
  delegationsCreated                            DelegationAuthority[] @relation("DelegationsCreatedBy")
  createdSuppliers                              Supplier[]            @relation("SuppliersCreatedBy")
  updatedSuppliers                              Supplier[]            @relation("SuppliersUpdatedBy")
  approvedPurchaseOrders                        PurchaseOrder[]       @relation("PurchaseOrdersApprovedBy")
  createdPurchaseOrders                         PurchaseOrder[]       @relation("PurchaseOrdersCreatedBy")
  updatedPurchaseOrders                         PurchaseOrder[]       @relation("PurchaseOrdersUpdatedBy")
  certifiedCafs                                 CertificationOfAvailability[] @relation("CafsCertifiedBy")
  createdCafs                                   CertificationOfAvailability[] @relation("CafsCreatedBy")
  updatedCafs                                   CertificationOfAvailability[] @relation("CafsUpdatedBy")
  orsRequestingOfficeCertifications             ObligationRequest[]   @relation("OrsRequestingOfficeCertifiedBy")
