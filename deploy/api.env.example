# LIVE production settings for the API. Copy this to apps/api/.env on the server
# and fill in the two REPLACE_ME values. Nothing else needs changing.

NODE_ENV=production
PORT=3000

# The EMPTY live database you created (never the demo's mswd_erp).
DATABASE_URL="postgresql://aquabooks_live:REPLACE_ME_DB_PASSWORD@localhost:5432/aquabooks_live?schema=public"

# A real random secret (min 32 chars). Generate one and paste it here:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_ME_WITH_A_64_CHAR_RANDOM_HEX_STRING"

# How long a login stays valid before it must sign in again.
JWT_EXPIRES_IN=8h
