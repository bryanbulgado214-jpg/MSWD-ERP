# LIVE production settings for the web app. Copy this to apps/web/.env on the
# server BEFORE running `npm run build` in apps/web.
#
# Keep it as "/api": the web server (vite preview) proxies /api to the API on
# :3000, so client PCs only use http://<server-ip>:5173 and there is no CORS.
VITE_API_BASE_URL="/api"
